# copy to .env.floppy on the server and fill in. do not commit .env.floppy
#
# only secrets live here. the non-secret settings (URLS, ALLOWED_HOSTS,
# REDIS_URL, PUID/PGID, data paths, feature flags) are set on the floppy
# service in docker-compose.yml under environment:

# required. generate with: openssl rand -base64 48
# losing this invalidates existing sessions and signed data
SECRET=

# required in practice — movie and tv metadata
# https://www.themoviedb.org/settings/api
TMDB_API=

# optional, one per media type you care about
# tv/anime metadata and grouped anime support — https://thetvdb.com/api-information
TVDB_API_KEY=
# anime via myanimelist, client id — https://myanimelist.net/apiconfig
MAL_API=
# games — https://www.igdb.com/api
IGDB_ID=
IGDB_SECRET=
# music scrobbles and history import — https://www.last.fm/api/account/create
LASTFM_API_KEY=
